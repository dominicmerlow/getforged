# ── Database (Neon Postgres + Drizzle) ─────────────────────────────────
# Create a project at https://neon.tech, then copy the pooled connection
# string. Run `npx drizzle-kit push` once to create the schema (db/schema.ts).
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ── Auth.js (magic link + Google + GitHub + email/password) ───────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── File storage (Vercel Blob) ─────────────────────────────────────────
# Auto-populated when a Vercel project has Blob storage attached. For local
# dev, create a store at https://vercel.com/dashboard/stores and copy the
# read-write token. Powers seller screenshot uploads (app/api/upload).
BLOB_READ_WRITE_TOKEN=

# ── Anthropic ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# FREE ALTERNATIVE: GROQ_API_KEY=gsk_...  (use groq sdk + llama-3.1-8b)

# ── Firecrawl ──────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-...
# FREE ALTERNATIVE: leave blank to use built-in fetch + cheerio scraper

# ── Resend ─────────────────────────────────────────────────────────────
# Doubles as the Auth.js magic-link provider (auth.ts) — required for
# passwordless sign-in, not just transactional email.
#
# RESEND_FROM_EMAIL has to sit on a domain verified in the SAME Resend
# workspace the API key belongs to. Leave it unset and Auth.js falls back to
# its own no-reply@authjs.dev, which Resend rejects with a 403 — sign-in then
# fails with nothing in the UI to say why. getbrian.xyz is the verified domain,
# and it is the apex that is verified, so do not put a subdomain here.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=getforged@getbrian.xyz
# FREE ALTERNATIVE: set SMTP_* vars below to use Gmail SMTP (nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password

# ── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://getforged.getbrian.xyz
GETFORGED_COMMISSION_RATE=0.15

# ── Analytics (PostHog) ───────────────────────────────────────────────
# Get these from https://app.posthog.com/project/settings (free tier: 1M events/mo)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ── Admin (gate /admin to one or more emails) ────────────────────────
# Single email: ADMIN_EMAIL=you@yourdomain.com
# Multiple admins: ADMIN_EMAIL=you@yourdomain.com,ops@yourdomain.com,clifton@gmail.com
# If unset, /admin is OPEN to any signed-in user (don't ship publicly without setting this)
ADMIN_EMAIL=you@yourdomain.com

# ── Sentry (error capture + replay) ───────────────────────────────────
# Get these from https://sentry.io project settings → Client Keys (DSN).
# Leave blank locally — Sentry init no-ops without a DSN.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=getforged
